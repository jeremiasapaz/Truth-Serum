# Copy to .env and fill in to enable real LLM scoring + evidence ingestion.
# If LLM_API_KEY is empty, the app falls back to the deterministic engine only.

# --- LLM (OpenAI-compatible) ---------------------------------------------
# Works with OpenAI, Groq (free), OpenRouter, Google Gemini (openai-compat),
# Together, local servers (Ollama/LM Studio), etc.
#
# Recommended FREE option — Groq (no credit card, ~1,000 req/day):
#   1. Get a key at https://console.groq.com/keys
#   2. Set:
#      LLM_API_KEY=gsk_your_key_here
#      LLM_BASE_URL=https://api.groq.com/openai/v1
#      LLM_MODEL=llama-3.3-70b-versatile
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# --- Network -------------------------------------------------------------
# Set to false behind a TLS-intercepting corporate proxy (self-signed CA),
# otherwise HTTPS calls to Wikipedia / gov APIs / the LLM will fail.
VERIFY_SSL=true

# --- Optional news collectors (need free keys) ---------------------------
# GNEWS_API_KEY=         # https://gnews.io
# NEWSAPI_KEY=           # https://newsapi.org

# Default evidence lookback window (e.g. 3m, 12m, 24m).
INGEST_TIMESPAN=12m

# --- Database ------------------------------------------------------------
DATABASE_URL=sqlite:///./transparency.db
