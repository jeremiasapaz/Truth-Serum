# Copy to .env and fill in to enable real LLM scoring.
# If LLM_API_KEY is empty, the app falls back to the deterministic engine only.

# OpenAI-compatible endpoint. Works with OpenAI, Azure OpenAI (adjust base),
# OpenRouter, Together, local servers (Ollama/LM Studio), etc.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Database (SQLite by default; swap for Postgres in production)
DATABASE_URL=sqlite:///./transparency.db
