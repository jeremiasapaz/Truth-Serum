# Copy to .env and fill in to enable real LLM scoring + evidence ingestion.
# If LLM_API_KEY is empty, the app falls back to the deterministic engine only.

# --- LLM (OpenAI-compatible) ---------------------------------------------
# Works with OpenAI, Groq (free), OpenRouter, Google Gemini (openai-compat),
# Together, local servers (Ollama/LM Studio), etc.
#
# Recommended FREE option — Google Gemini (no credit card, ~1,500 req/day,
# reachable even behind strict corporate firewalls that block Groq/OpenRouter):
#   1. Get a key at https://aistudio.google.com/app/apikey
#   2. Set:
#      LLM_API_KEY=your_gemini_key
#      LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#      LLM_MODEL=gemini-2.0-flash
# Other OpenAI-compatible options (if reachable): Groq, OpenRouter, Together, Mistral.
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-3.8-flash

# --- Network -------------------------------------------------------------
# Set to false behind a TLS-intercepting corporate proxy (self-signed CA),
# otherwise HTTPS calls to Wikipedia / gov APIs / the LLM will fail.
VERIFY_SSL=true

# --- News sources --------------------------------------------------------
# KEYLESS (work out of the box): Wikipedia, Google News RSS, Bing News RSS,
#   and direct outlet/TV RSS feeds (BBC, Al Jazeera, Folha, RTÉ, SCMP, ...).
# OPTIONAL keyed aggregators (each spans many outlets) — add to widen coverage:
# GNEWS_API_KEY=         # https://gnews.io
# NEWSAPI_KEY=           # https://newsapi.org
# NEWSDATA_API_KEY=      # https://newsdata.io
# MEDIASTACK_API_KEY=    # https://mediastack.com
# CURRENTS_API_KEY=      # https://currentsapi.services

# Default evidence lookback window (e.g. 3m, 12m, 24m).
INGEST_TIMESPAN=12m
# Max items pulled from each individual news source (bounds LLM cost).
MAX_ITEMS_PER_SOURCE=60

# --- Database ------------------------------------------------------------
DATABASE_URL=sqlite:///./transparency.db
